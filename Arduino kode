bool Gustav = false;

void setup() {
  Serial.begin(9600);
  pinMode(11, OUTPUT);
}

void loop() {
  if (Serial.available() > 0) {
    String msg = Serial.readString();
    Serial.println("Besked modtaget");

    if (msg == "1"){
      digitalWrite(11, HIGH);
      Serial.println("Besked er 1");
    }
    else if (msg == "2"){
      digitalWrite(11, LOW);
      Serial.println("Besked er 2");
    }
  }
  if (Gustav==true) {
    digitalWrite(11, HIGH);
  } 
}
