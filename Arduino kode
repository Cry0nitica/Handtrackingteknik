const int outputPin = 11;

void setup() {
  Serial.begin(9600);
  pinMode(outputPin, OUTPUT);
  digitalWrite(outputPin, LOW);
}

void loop() {
  if (Serial.available() > 0) {
    char msg = Serial.read();

    if (msg == '1') {
      digitalWrite(outputPin, HIGH);
      Serial.println("Besked er 1");
    }
    else if (msg == '2') {
      digitalWrite(outputPin, LOW);
      Serial.println("Besked er 2");
    }
  }
}
